rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'srikar37801@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidAdmissionInquiry(data) {
      return data.keys().hasAll([
          'parentName',
          'mobileNumber',
          'villageOrTown',
          'program',
          'studentName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'parentName',
          'mobileNumber',
          'villageOrTown',
          'program',
          'studentName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.parentName is string
        && data.parentName.size() >= 1
        && data.parentName.size() <= 100
        && data.mobileNumber is string
        && data.mobileNumber.size() >= 7
        && data.mobileNumber.size() <= 20
        && data.mobileNumber.matches('^[+0-9\\s\\-()]{7,20}$')
        && data.villageOrTown is string
        && data.villageOrTown.size() >= 1
        && data.villageOrTown.size() <= 100
        && data.program is string
        && data.program.size() <= 30
        && data.program in ['IIT-NEET', 'High School', 'Primary', 'Navodaya-Sainik']
        && data.studentName is string
        && data.studentName.size() <= 100
        && data.status is string
        && data.status.size() <= 20
        && data.status in ['new', 'contacted', 'enrolled', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCampusVisit(data) {
      return data.keys().hasAll([
          'visitorName',
          'contactNumber',
          'preferredDate',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'visitorName',
          'contactNumber',
          'preferredDate',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.visitorName is string
        && data.visitorName.size() >= 1
        && data.visitorName.size() <= 100
        && data.contactNumber is string
        && data.contactNumber.size() >= 7
        && data.contactNumber.size() <= 20
        && data.contactNumber.matches('^[+0-9\\s\\-()]{7,20}$')
        && data.preferredDate is string
        && data.preferredDate.size() == 10
        && data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status is string
        && data.status.size() <= 20
        && data.status in ['scheduled', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    match /admissionInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidAdmissionInquiry(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidAdmissionInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'archived'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /campusVisits/{visitId} {
      allow get: if isValidId(visitId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(visitId)
        && isValidCampusVisit(incoming())
        && incoming().status == 'scheduled'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(visitId)
        && isAdmin()
        && isValidCampusVisit(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'cancelled'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(visitId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId)
        && isAdmin()
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
